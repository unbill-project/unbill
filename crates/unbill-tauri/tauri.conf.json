{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unbill",
  "version": "0.0.4",
  "identifier": "computer.unbill",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../apps/unbill-ui-native",
      "script": "trunk serve --config Trunk.toml",
      "wait": false
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "cwd": "../../apps/unbill-ui-native",
      "script": "trunk build --config Trunk.toml --release"
    },
    "frontendDist": "../../apps/unbill-ui-native/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "unbill",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "BB577FKUK4",
      "frameworks": ["SystemConfiguration"],
      "template": "ios/project.yml"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MzlBOURBQzlEMzhFQzgKUldUSWp0UEoycWs1WmxTSS94L0QxeS8xOFJPdUQ2bDlpd0RyNk9BY0FCNmVsMFdic1BvTFdxMjAK",
      "endpoints": [
        "https://github.com/unbill-project/unbill/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["unbill"]
      },
      "mobile": [
        {
          "scheme": ["unbill"],
          "appLink": false
        }
      ]
    }
  }
}
